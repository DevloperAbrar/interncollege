@"
# Environment files — never commit secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/
backend/dist/

# Uploaded files (user-generated, not source code)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Misc
*.local
"@ | Set-Content -Path .gitignore -Encoding utf8